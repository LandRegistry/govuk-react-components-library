{
  "name": "@hmlr/govuk-react-components-library",
  "version": "1.3.1",
  "description": "These are common component use for React applications based on GDS and govuk-frontend",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./PDFViewerCanvas": {
      "import": "./dist/PDFViewerCanvas.esm.js",
      "require": "./dist/PDFViewerCanvas.cjs.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && rollup -c --bundleConfigAsCjs",
    "prepublishOnly": "npm run build",
    "dev": "rollup -c -w",
    "test": "jest  --collect-coverage",
    "storybook": "storybook dev -p 6006 --debug-webpack",
    "build-storybook": "storybook build --debug-webpack",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:6006 && npm run test-storybook -- --maxWorkers=2\"",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check '**/*.+(js|mjs|ts|tsx|json|css|scss|html|md)'",
    "lint": "eslint 'src/**/*.ts*' && npm run format:check && stylelint 'src/**/*.{css,scss,less}'",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write '**/*.+(js|mjs|ts|tsx|json|css|scss|html|md)'",
    "lint-fix": "eslint --fix 'src/**/*.ts*' && npm run format && stylelint --fix 'src/**/*.{css,scss,less}' ",
    "prepare": "husky",
    "release": "standard-version",
    "uml": "tsuml2 --glob './src/**/\\!(*.spec|*.test|TestUtilities|JestSetup).[t]s?(x)' -o './assets/uml-diagram.svg'",
    "chromatic": "npx chromatic --exit-zero-on-changes",
    "generate-stories": "node scripts/generateStories.mjs",
    "prestorybook": "npm run generate-stories",
    "prebuild-storybook": "npm run generate-stories"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LandRegistry/govuk-react-components-library.git"
  },
  "bugs": {
    "url": "https://github.com/LandRegistry/govuk-react-components-library/issues"
  },
  "homepage": "https://github.com/LandRegistry/govuk-react-components-library#readme",
  "keywords": [
    "GDS",
    "govuk",
    "govuk-frontend",
    "React",
    "UI",
    "Components"
  ],
  "author": "Cyril Adelekan",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@chromatic-com/storybook": "^5.3.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-styling-webpack": "^3.0.2",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/react-vite": "^10.6.0",
    "@storybook/react-webpack5": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/govuk-frontend": "^5.11.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "assert": "^2.1.0",
    "autoprefixer": "^10.6.1",
    "babel-jest": "^30.5.2",
    "bootstrap": "^5.3.8",
    "chromatic": "^18.9.5",
    "concurrently": "^10.0.5",
    "css-loader": "^7.1.5",
    "deep-iterator": "^1.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "govuk-frontend": "^6.5.1",
    "html-react-parser": "^5.2.17",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "magicast": "^0.5.5",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-element-to-jsx-string": "^17.0.1",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.4",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^6.0.11",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "standard-version": "^9.5.0",
    "storybook": "^10.6.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "tslib": "^2.8.1",
    "tsuml2": "^0.17.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "unplugin": "^3.4.0",
    "wait-on": "^9.1.0",
    "webpack": "^5.111.1"
  },
  "peerDependencies": {
    "govuk-frontend": ">=5.14.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "react-router": ">=6.30.0",
    "react-router-dom": ">=6.30.0"
  },
  "optionalDependencies": {
    "pdfjs-dist": ">=6.3.289"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      ".(css|less|scss)$": "identity-obj-proxy"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/JestSetup.ts"
    ],
    "testEnvironmentOptions": {
      "customExportConditions": [
        "react-native"
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(html-react-parser|domhandler|domelementtype|dom-serializer|entities|html-dom-parser)/)"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 85,
        "functions": 95,
        "lines": 85
      }
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react",
      "@babel/preset-typescript"
    ]
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "dependencies": {
    "ts-dedent": "^2.3.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@2.6.12": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.2": true
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "prettier --write CHANGELOG.md"
    }
  }
}
